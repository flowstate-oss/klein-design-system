{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@klein-ui/react": ["./packages/react/src/index.ts"],
      "@klein-ui/tokens": ["./packages/tokens/index.ts"],
      "@klein-ui/table": ["./packages/table/src/index.ts"],
      "@klein-ui/charts": ["./packages/charts/src/index.ts"],
      "@klein-ui/forecast": ["./packages/forecast/src/index.tsx"],
      "@klein-ui/eddy": ["./packages/eddy/src/index.tsx"],
      "@klein-ui/react/*": ["./packages/react/src/*"],
      "@klein-ui/table/*": ["./packages/table/src/*"],
      "@klein-ui/charts/*": ["./packages/charts/src/*"],
      "@klein-ui/forecast/*": ["./packages/forecast/src/*"],
      "@klein-ui/eddy/*": ["./packages/eddy/src/*"]
    }
  },
  "include": [
    "packages/*/src",
    "apps/docs/src",
    "tests",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
