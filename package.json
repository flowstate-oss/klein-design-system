{
  "name": "klein-design-system",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @klein-ui/docs",
    "generate": "node scripts/generate.mjs && node scripts/generate-migration.mjs",
    "check:generated": "node scripts/generate.mjs --check && node scripts/generate-migration.mjs --check",
    "build": "npm run generate && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build:docs": "npm run build && npm run build -w @klein-ui/docs",
    "check": "npm run check:generated && node scripts/build.mjs && npm run typecheck && npm run check:examples && npm run check:docs && npm test && node scripts/check-boundaries.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "format": "prettier --write . && npm run generate",
    "release:version": "node scripts/release-version.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "check:docs": "npm exec -w @klein-ui/docs -- astro check --minimumFailingSeverity error"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.11.1",
    "jsdom": "27.4.0",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10"
  },
  "license": "MIT",
  "author": "Flowstate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowstate-oss/klein-design-system.git"
  }
}
